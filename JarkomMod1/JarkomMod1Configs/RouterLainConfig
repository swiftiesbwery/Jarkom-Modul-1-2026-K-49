# === NOMOR 2: Koneksi Internet via NAT/DHCP ===
auto eth0
iface eth0 inet dhcp

# === NOMOR 3: IP Forwarding untuk Routing Antar Subnet ===
    up sysctl -w net.ipv4.ip_forward=1

# === NOMOR 4: NAT Masquerade ===
    up iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE

# === NOMOR 5: Script Verifikasi cek_status.sh ===
    up mkdir -p /root
    up echo '#!/bin/bash' > /root/cek_status.sh
    up echo 'echo "=== Interface Summary ==="' >> /root/cek_status.sh
    up echo 'ip -br a' >> /root/cek_status.sh
    up echo 'echo ""' >> /root/cek_status.sh
    up echo 'echo "=== NAT Table Status ==="' >> /root/cek_status.sh
    up echo 'iptables -t nat -L -v -n' >> /root/cek_status.sh
    up chmod +x /root/cek_status.sh

# === NOMOR 1 & 2: Interface LAN (Gateway untuk setiap subnet) ===
auto eth1
iface eth1 inet static
    address 10.88.1.1
    netmask 255.255.255.0

auto eth2
iface eth2 inet static
    address 10.88.2.1
    netmask 255.255.255.0

auto eth3
iface eth3 inet static
    address 10.88.3.1
    netmask 255.255.255.0